{
  "name": "battle-ranker",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i frontend/input.css -o ranker/static/output.css --minify",
    "build:css:watch": "tailwindcss -i frontend/input.css -o ranker/static/output.css --watch=always",
    "test:browser": "playwright test --config tests/browser/playwright.config.cjs",
    "test:js": "node --test tests/test_battle_js.cjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
